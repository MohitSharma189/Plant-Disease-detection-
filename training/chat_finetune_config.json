{
  "base_model": "Qwen/Qwen2.5-7B-Instruct",
  "dataset_dir": "reports/generated/chat_finetune",
  "output_dir": "saved_models/chat_adapter_candidate",
  "method": "qlora",
  "load_in_4bit": true,
  "lora_r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj"],
  "epochs": 2,
  "learning_rate": 0.0002,
  "per_device_train_batch_size": 1,
  "gradient_accumulation_steps": 8,
  "max_seq_length": 1024,
  "evaluation_strategy": "steps",
  "eval_steps": 10,
  "save_steps": 10,
  "seed": 42,
  "note": "Optional external trainer configuration. The Ollama model is not modified by this repository. Evaluate the adapter before deployment."
}
